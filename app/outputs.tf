locals {
  lb_hostname = module.helpdesk.load_balancer_hostname

  # Final records the user creates at their DNS provider. Route53 mode gets
  # them from external-dns, so none are needed there.
  dns_records = local.dns_mode == "route53" || local.lb_hostname == "" ? [] : [
    { name = var.deployment.host, type = "CNAME", value = local.lb_hostname },
    { name = var.deployment.xterm_host, type = "CNAME", value = local.lb_hostname },
  ]
}

output "load_balancer_hostname" {
  description = "ALB hostname serving Helpdesk; empty until the load balancer is provisioned"
  value       = local.lb_hostname
}

output "helpdesk_url" {
  description = "Helpdesk URL"
  value       = "https://${var.deployment.host}"
}

output "dns_records" {
  description = "CNAME records to create for the Helpdesk hosts; empty when Route53 manages DNS"
  value       = local.dns_records
}

output "secrets" {
  description = "Echo of var.secrets so a takeover can read user-entered secrets back"
  value       = var.secrets
  sensitive   = true
}

output "generated" {
  description = "Secrets generated by this root"
  sensitive   = true
  value = {
    jwt_shared_secret     = random_password.jwt_shared_secret.result
    mongodb_root_password = random_password.mongodb_root_password.result
  }
}
